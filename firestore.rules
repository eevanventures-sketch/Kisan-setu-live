rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'dev.rgu201@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validators (Anti-Update-Gap)
    function isValidMandiPatrak(data) {
      return data.keys().hasAll([
          'mandiId', 'mandiName', 'district', 'state', 'date',
          'totalContracts', 'totalArrival', 'arrivalUnit',
          'releaseTime', 'sourceType', 'rows', 'updatedByUid', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'mandiId', 'mandiName', 'district', 'state', 'date',
          'totalContracts', 'totalArrival', 'arrivalUnit',
          'releaseTime', 'sourceType', 'rows', 'updatedByUid', 'updatedAt'
        ])
        && data.mandiId is string && data.mandiId.size() >= 2 && data.mandiId.size() <= 100 && data.mandiId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.mandiName is string && data.mandiName.size() >= 2 && data.mandiName.size() <= 150
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 100
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 100
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{2}-[0-9]{2}-[0-9]{4}$')
        && data.totalContracts is string && data.totalContracts.size() >= 1 && data.totalContracts.size() <= 40
        && data.totalArrival is string && data.totalArrival.size() >= 1 && data.totalArrival.size() <= 40
        && data.arrivalUnit in ['बोरी', 'क्विंटल']
        && data.releaseTime is string && data.releaseTime.size() >= 2 && data.releaseTime.size() <= 200
        && data.sourceType in ['photo_scan', 'manual_official', 'govt_sync']
        && data.rows is list && data.rows.size() > 0 && data.rows.size() <= 60
        && data.rows[0] is map
        && data.rows[0].keys().hasAll(['sNo', 'cropName', 'contracts', 'arrival', 'minPrice', 'maxPrice', 'modalPrice'])
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid
        && data.updatedAt == request.time;
    }

    function isValidUserPreference(data, userId) {
      return data.keys().hasAll(['userId', 'favoriteMandiId', 'favoriteState', 'favoriteDistrict', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'favoriteMandiId', 'favoriteState', 'favoriteDistrict', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid && data.userId == userId
        && data.favoriteMandiId is string && data.favoriteMandiId.size() >= 2 && data.favoriteMandiId.size() <= 100 && data.favoriteMandiId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.favoriteState is string && data.favoriteState.size() >= 2 && data.favoriteState.size() <= 100
        && data.favoriteDistrict is string && data.favoriteDistrict.size() >= 2 && data.favoriteDistrict.size() <= 100
        && data.updatedAt == request.time;
    }

    function isValidBazaarListing(data) {
      return data.keys().hasAll([
          'authorUid', 'type', 'title', 'description', 'price', 'priceUnit',
          'quantity', 'location', 'state', 'sellerName', 'contactPhone',
          'mediaType', 'thumbnailData', 'videoMediaId', 'videoChunkCount',
          'videoMimeType', 'externalVideoUrl', 'companyName', 'discountOffer',
          'targetPestOrCrop', 'likesCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorUid', 'type', 'title', 'description', 'price', 'priceUnit',
          'quantity', 'location', 'state', 'sellerName', 'contactPhone',
          'mediaType', 'thumbnailData', 'videoMediaId', 'videoChunkCount',
          'videoMimeType', 'externalVideoUrl', 'companyName', 'discountOffer',
          'targetPestOrCrop', 'likesCount', 'createdAt', 'updatedAt'
        ])
        && data.authorUid is string && data.authorUid.size() >= 5 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.type in ['sell_crop', 'rent_equipment', 'seeds_fertilizer', 'dairy_livestock', 'farm_experience', 'company_promo']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 150
        && data.description is string && data.description.size() >= 2 && data.description.size() <= 1000
        && (data.price is int || data.price is float) && data.price >= 0 && data.price <= 100000000
        && data.priceUnit is string && data.priceUnit.size() >= 1 && data.priceUnit.size() <= 60
        && data.quantity is string && data.quantity.size() >= 1 && data.quantity.size() <= 80
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 120
        && data.state is string && data.state.size() >= 2 && data.state.size() <= 60
        && data.sellerName is string && data.sellerName.size() >= 2 && data.sellerName.size() <= 100
        && data.contactPhone is string && data.contactPhone.size() >= 6 && data.contactPhone.size() <= 25
        && data.mediaType in ['image', 'video']
        && data.thumbnailData is string && data.thumbnailData.size() <= 250000
        && data.videoMediaId is string && data.videoMediaId.size() <= 128
        && data.videoChunkCount is int && data.videoChunkCount >= 0 && data.videoChunkCount <= 20
        && data.videoMimeType is string && data.videoMimeType.size() <= 60
        && data.externalVideoUrl is string && data.externalVideoUrl.size() <= 500
        && data.companyName is string && data.companyName.size() <= 120
        && data.discountOffer is string && data.discountOffer.size() <= 120
        && data.targetPestOrCrop is string && data.targetPestOrCrop.size() <= 150
        && data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000
        && data.updatedAt == request.time;
    }

    function isValidBazaarVideoChunk(data) {
      return data.keys().hasAll([
          'videoMediaId', 'chunkIndex', 'totalChunks', 'mimeType', 'data', 'authorUid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'videoMediaId', 'chunkIndex', 'totalChunks', 'mimeType', 'data', 'authorUid', 'createdAt'
        ])
        && data.videoMediaId is string && data.videoMediaId.size() >= 2 && data.videoMediaId.size() <= 128 && data.videoMediaId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex <= 20
        && data.totalChunks is int && data.totalChunks >= 1 && data.totalChunks <= 20
        && data.chunkIndex < data.totalChunks
        && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 60
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 750000
        && data.authorUid is string && data.authorUid == request.auth.uid && data.authorUid.size() >= 5 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt == request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'photoUrl',
          'village', 'district', 'state', 'phone', 'role', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoUrl',
          'village', 'district', 'state', 'phone', 'role', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.photoUrl is string && data.photoUrl.size() <= 500
        && data.village is string && data.village.size() <= 100
        && data.district is string && data.district.size() <= 100
        && data.state is string && data.state.size() <= 100
        && data.phone is string && data.phone.size() <= 25
        && data.role in ['farmer', 'admin']
        && data.updatedAt == request.time;
    }

    // 4. Collection Rules
    match /mandiPatraks/{patrakId} {
      // Public agricultural price board (zero PII) so all farmers get 24/7 auto-sync
      allow get: if isValidId(patrakId);
      allow list: if true;
      allow create: if isValidId(patrakId) && isAdmin() && isValidMandiPatrak(incoming());
      allow update: if isValidId(patrakId) && isAdmin() && isValidMandiPatrak(incoming())
        && incoming().mandiId == existing().mandiId
        && incoming().date == existing().date
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'mandiName', 'district', 'state', 'totalContracts', 'totalArrival',
          'arrivalUnit', 'releaseTime', 'sourceType', 'rows', 'updatedByUid', 'updatedAt'
        ]);
      allow delete: if isValidId(patrakId) && isAdmin();
    }

    match /userPreferences/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserPreference(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserPreference(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'favoriteMandiId', 'favoriteState', 'favoriteDistrict', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /bazaarListings/{listingId} {
      // Public farmer & dealer marketplace feed
      allow get: if isValidId(listingId);
      allow list: if true;
      allow create: if isValidId(listingId) && isVerifiedUser()
        && isValidBazaarListing(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(listingId) && isVerifiedUser()
        && isValidBazaarListing(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && (
          // Action 1: Owner or Admin updates listing details
          ((isOwner(existing().authorUid) || isAdmin()) && incoming().diff(existing()).affectedKeys().hasOnly([
            'type', 'title', 'description', 'price', 'priceUnit', 'quantity',
            'location', 'state', 'sellerName', 'contactPhone', 'mediaType',
            'thumbnailData', 'companyName', 'discountOffer', 'targetPestOrCrop', 'updatedAt'
          ])) ||
          // Action 2: Community like increment (+1 only)
          (incoming().likesCount == existing().likesCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']))
        );
      allow delete: if isValidId(listingId) && (isOwner(existing().authorUid) || isAdmin());
    }

    match /bazaarVideoChunks/{chunkDocId} {
      allow get: if isValidId(chunkDocId);
      allow list: if true;
      allow create: if isValidId(chunkDocId) && isVerifiedUser() && isValidBazaarVideoChunk(incoming());
      allow update: if false;
      allow delete: if isValidId(chunkDocId) && (isOwner(existing().authorUid) || isAdmin());
    }

    match /users/{userId} {
      // Strict PII isolation: only profile owner or verified admin can read; never listable
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().role == 'farmer'
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoUrl', 'village', 'district', 'state', 'phone', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
